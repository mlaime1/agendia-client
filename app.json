      },
      "splash": {
        "image": "./assets/icon/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F4F3EE"
      }
    },
    "extra": {
      "eas": {
        "projectId": "c9616bb2-90e4-4bac-b8e0-19fea893e357"
